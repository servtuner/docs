---
interface Box {
  x: number;
  y: number;
  w: number;
  h?: number;
  title: string;
  lines?: string[];
  hot?: boolean;
}
interface Arrow {
  d: string;
  label?: string;
  at?: [number, number];
  both?: boolean;
  anchor?: string;
  dashed?: boolean;
}
interface Props {
  id: string;
  title: string;
  desc: string;
  width: number;
  height: number;
  boxes: Box[];
  arrows: Arrow[];
  caption?: string;
}
const { id, title, desc, width, height, boxes, arrows, caption } = Astro.props;
---

<figure class="diagram not-content">
  <div class="scroll" tabindex="0" role="group" aria-label={`${title} diagram, scrollable`}>
    <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${id}-t ${id}-d`}>
      <title id={`${id}-t`}>{title}</title>
      <desc id={`${id}-d`}>{desc}</desc>
      <defs>
        <marker
          id={`${id}-a`}
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M0 0 10 5 0 10z" class="head" />
        </marker>
      </defs>
      {arrows.map((a) => (
        <path
          d={a.d}
          class:list={['edge', { dashed: a.dashed }]}
          marker-end={`url(#${id}-a)`}
          marker-start={a.both ? `url(#${id}-a)` : undefined}
        />
      ))}
      {arrows
        .filter((a) => a.label)
        .map((a) => (
          <text x={a.at![0]} y={a.at![1]} class="label" text-anchor={a.anchor ?? 'middle'}>
            {a.label}
          </text>
        ))}
      {boxes.map((b) => {
        const h = b.h ?? 56;
        const lines = b.lines ?? [];
        const top = b.y + h / 2 - (lines.length * 16) / 2 + 5;
        return (
          <g>
            <rect x={b.x} y={b.y} width={b.w} height={h} rx="8" class:list={['box', { hot: b.hot }]} />
            <text x={b.x + b.w / 2} y={top} class="name" text-anchor="middle">
              {b.title}
            </text>
            {lines.map((l, i) => (
              <text x={b.x + b.w / 2} y={top + 16 * (i + 1) + 1} class="line" text-anchor="middle">
                {l}
              </text>
            ))}
          </g>
        );
      })}
    </svg>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .diagram {
    margin: 1.5rem 0;
  }
  .scroll {
    overflow-x: auto;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }
  svg {
    display: block;
    width: 100%;
    min-width: 510px;
    height: auto;
    font-family: var(--__sl-font, sans-serif);
  }
  /* Phones scroll the diagram instead of shrinking its text. */
  @media (max-width: 40rem) {
    svg {
      min-width: 760px;
    }
  }
  .box {
    fill: var(--dg-box);
    stroke: var(--dg-edge);
    stroke-width: 1.2;
  }
  .box.hot {
    fill: var(--dg-hot-box);
    stroke: var(--dg-hot);
  }
  .name {
    fill: var(--sl-color-white);
    font-size: 14px;
    font-weight: 600;
  }
  .line,
  .label {
    fill: var(--sl-color-gray-2);
    font-size: 12px;
  }
  .label {
    paint-order: stroke;
    stroke: var(--sl-color-bg);
    stroke-width: 5px;
  }
  .edge {
    fill: none;
    stroke: var(--dg-edge);
    stroke-width: 1.5;
  }
  .dashed {
    stroke-dasharray: 5 4;
  }
  .head {
    fill: var(--dg-edge);
  }
  figcaption {
    margin-top: 0.5rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
</style>
