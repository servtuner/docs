---
import Default from '@astrojs/starlight/components/Header.astro';
import VersionPicker from './VersionPicker.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const section = Astro.locals.starlightRoute.id.split('/')[0];
const tabs = [
  {
    label: 'Documentation',
    href: `${base}/overview/what-is-servtuner/`,
    current: !['deployment', 'reference'].includes(section ?? ''),
  },
  { label: 'Deployment', href: `${base}/deployment/`, current: section === 'deployment' },
  { label: 'Reference', href: `${base}/reference/`, current: section === 'reference' },
];
---

<div class="top">
  <Default />
</div>
<nav class="tabs" aria-label="Sections">
  {tabs.map((t) => (
    <a href={t.href} aria-current={t.current ? 'true' : undefined}>
      {t.label}
    </a>
  ))}
  <VersionPicker />
</nav>

<style>
  .top {
    height: 2.5rem;
  }
  .tabs {
    display: flex;
    gap: 1.5rem;
    height: 2.25rem;
    margin-top: 0.4rem;
  }
  .tabs a {
    display: flex;
    align-items: center;
    padding-bottom: 0.2rem;
    border-bottom: 2px solid transparent;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }
  .tabs a:hover {
    color: var(--sl-color-white);
  }
  .tabs a[aria-current] {
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-white);
    font-weight: 600;
  }
</style>
